<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_hero_height"
    android:layout_marginHorizontal="@dimen/padding_medium"
    android:layout_marginVertical="@dimen/padding_tiny"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/padding_small">

        <ImageView
            android:id="@+id/image_hero_avatar"
            android:layout_width="@dimen/avatar_size_medium"
            android:layout_height="@dimen/avatar_size_medium"
            android:scaleType="centerCrop"
            android:contentDescription="@string/content_desc_hero_avatar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_heroes" />

        <TextView
            android:id="@+id/text_hero_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_small"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_large"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/badge_tier"
            app:layout_constraintStart_toEndOf="@id/image_hero_avatar"
            app:layout_constraintTop_toTopOf="@id/image_hero_avatar"
            tools:text="盖伦" />

        <TextView
            android:id="@+id/text_hero_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_small"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small"
            app:layout_constraintStart_toEndOf="@id/image_hero_avatar"
            app:layout_constraintTop_toBottomOf="@id/text_hero_name"
            tools:text="战士" />

        <com.aram.mayhem.ui.widget.TierBadgeView
            android:id="@+id/badge_tier"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/badge_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_hero_name" />

        <TextView
            android:id="@+id/text_win_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/padding_small"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small"
            app:layout_constraintBottom_toBottomOf="@id/image_hero_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="胜率 52.3%" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
