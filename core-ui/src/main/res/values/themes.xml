<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ARAMMayhem" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.ARAMMayhem.Splash" parent="Theme.ARAMMayhem">
        <item name="android:windowBackground">@color/primary_dark</item>
    </style>

    <style name="Widget.ARAMMayhem.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.ARAMMayhem.CardView.Small" parent="Widget.ARAMMayhem.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius_small</item>
    </style>

    <style name="Widget.ARAMMayhem.CardView.Large" parent="Widget.ARAMMayhem.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius_large</item>
    </style>

    <style name="Widget.ARAMMayhem.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
    </style>

    <style name="Widget.ARAMMayhem.SearchBar" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/search_bar_height</item>
        <item name="boxCornerRadiusTopEnd">@dimen/search_bar_height</item>
        <item name="boxCornerRadiusBottomStart">@dimen/search_bar_height</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/search_bar_height</item>
    </style>

    <style name="Widget.ARAMMayhem.TierBadge" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">@dimen/padding_small</item>
        <item name="android:paddingEnd">@dimen/padding_small</item>
        <item name="android:paddingTop">@dimen/padding_tiny</item>
        <item name="android:paddingBottom">@dimen/padding_tiny</item>
    </style>

    <style name="Widget.ARAMMayhem.QualityChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="chipMinHeight">@dimen/badge_height</item>
    </style>

    <style name="Widget.ARAMMayhem.VoteButton" parent="">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/padding_small</item>
    </style>

    <style name="TextAppearance.ARAMMayhem.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.ARAMMayhem.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.ARAMMayhem.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_hint</item>
    </style>
</resources>
